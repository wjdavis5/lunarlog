<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- U7: device-credential gate (biometric prompt with passcode fallback). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- U8: reminders. POST_NOTIFICATIONS covers Android 13+; the boot
         permission lets flutter_local_notifications restore the schedule
         after a reboot (KTD7). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- U4: account sign-in and sync talk to Supabase; absent before, so
         earlier builds had no network at all. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Issue #166: Health Connect permissions for the v1 (menstruation-only)
         baseline scoped by #202 (HS-7). The #173 platform-channel adapter and
         the #193/#374 opt-in write paths are live behind the bound-profile
         gate (AppConfig.hasHealthSync is true). Writes go only into the
         on-device Health Connect store — nothing is transmitted off-device
         through this feature, and no predicted or derived cycle value is
         ever written (issue #254's written rule; see
         docs/ops/play-health-declaration.md for the Play Console Health apps
         declaration these permissions require before any production-track
         ship). Issue #458 (the owner's #781 read decision, applied to iOS in
         #217) adds the read/import direction for the same two user-recorded
         types: HealthConnectAdapter.kt's readPermissions set requests
         getReadPermission for both, the user-initiated import calls
         getChangesToken/getChanges, and the native read drops any record
         whose dataOrigin is this app so our own writes are never
         re-imported. Issue #992 lifts the old 30-day cap: the read is now
         full-history and paged, which is why READ_HEALTH_DATA_HISTORY is
         declared and requested below (without it Health Connect returns
         only the 30 days preceding the permission grant). Background reads
         (READ_HEALTH_DATA_IN_BACKGROUND) remain undeclared — the import is
         still user-initiated only. Extend this list (never widen it
         silently) as later HS issues add data types — adding one re-triggers
         Play's Health apps declaration review; do NOT add background or
         sexual-activity permissions here. -->
    <uses-permission android:name="android.permission.health.WRITE_MENSTRUATION"/>
    <uses-permission android:name="android.permission.health.WRITE_INTERMENSTRUAL_BLEEDING"/>
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION"/>
    <uses-permission android:name="android.permission.health.READ_INTERMENSTRUAL_BLEEDING"/>
    <!-- Issue #992: full-history import. Health Connect caps a read at the
         30 days preceding the permission grant unless the app holds this
         permission. It is requested alongside the read set (see
         HealthConnectAdapter.kt's readPermissions) and only ever read from —
         never written. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY"/>
    <!-- Issue #228: the fertility/measurement family's WRITE permissions.
         Cervical mucus, ovulation test, and basal body temperature are
         distinct Health Connect permissions (unlike the menstruation
         family's shared WRITE_MENSTRUATION, which also covers
         MenstruationPeriodRecord). Write-only: issue #228's scope reads none
         of these back, so no READ_* counterparts are declared. The mapping
         tables live in lib/data/health/health_fertility_mapping.dart and the
         port methods are gated by the same #153 device-owner guard as every
         other write. -->
    <uses-permission android:name="android.permission.health.WRITE_CERVICAL_MUCUS"/>
    <uses-permission android:name="android.permission.health.WRITE_OVULATION_TEST"/>
    <uses-permission android:name="android.permission.health.WRITE_BASAL_BODY_TEMPERATURE"/>
    <application
        android:label="lunarlog"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- U4 (KTD8): auth callback for confirmation and password-reset
                 emails, lunarlog://auth-callback. PKCE binds the code to the
                 verifier in this app's secure storage, so a scheme claimed
                 by another app yields nothing.
                 U8 (R9): guardian invitations, lunarlog://invite?code=...
                 Both data elements live in this one filter — Android ORs
                 multiple <data> entries within an intent-filter, so either
                 host launches the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="lunarlog" android:host="auth-callback"/>
                <data android:scheme="lunarlog" android:host="invite"/>
            </intent-filter>
            <!-- Issue #129, #450: HTTPS App Link fallback for invite/claim links
                 (https://lunarlog.app/invite?code=...). Hosted on lunarlog.app.
                 autoVerify makes an installed, verified app open these links
                 directly once assetlinks.json is published with production
                 certificate fingerprints. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="lunarlog.app" android:pathPrefix="/invite"/>
            </intent-filter>
        </activity>
        <!-- Issue #166: minimal, standalone activity (not Flutter; Health
             Connect can launch this without booting the Flutter engine) that
             satisfies both rationale entry points Health Connect requires:
             the permissions-grant flow (SHOW_PERMISSIONS_RATIONALE) and the
             Android 14+ "why does this app have access" surface, exposed via
             an activity-alias restricted to the platform's own
             START_VIEW_PERMISSION_USAGE caller. Both show the same static
             privacy-policy content; see PermissionsRationaleActivity.kt. -->
        <activity
            android:name=".PermissionsRationaleActivity"
            android:exported="true"
            android:label="lunarlog">
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".PermissionsRationaleActivityAlias"
            android:exported="true"
            android:targetActivity=".PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <!-- Issue #141: the home-screen widget provider. exported="false"
             is the current AppWidget docs shape — the system delivers
             APPWIDGET_UPDATE with system privileges. The provider only
             reads the shared HomeWidgetPreferences store and renders the
             discreet state; the quick-log button opens the app (never
             writes; the write applies after the device-credential gate). -->
        <receiver
            android:name=".LunarLogWidgetProvider"
            android:exported="false"
            android:label="lunarlog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lunarlog_widget_info"/>
        </receiver>
        <!-- U8: flutter_local_notifications receivers (schedule delivery and
             restore after reboot). -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Issue #174: FCM's own tray presentations (a backgrounded
             caregiver alert's notification payload) land on the same
             "Reminders" channel and the same launcher icon the locally
             scheduled reminders use (kReminderChannelId in
             lib/data/notifications/notification_scheduler.dart, which the
             scheduler creates at initialize; AndroidInitializationSettings
             uses the same @mipmap/ic_launcher), so a caregiver alert is
             visually identical to a local reminder instead of landing in
             the system default channel with a generic icon. The two values
             are pinned against the Dart constants by
             test/release/fcm_presentation_manifest_test.dart. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="lunarlog_reminders" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Issue #166: lets the app see whether the Health Connect app is
             installed (SdkAvailability check) despite package-visibility
             restrictions; required regardless of whether Health Connect is
             built into the OS (Android 14+) or a separate installable app
             (Android 9-13). -->
        <package android:name="com.google.android.apps.healthdata"/>
        <!-- Issue #534: the lock screen's "Open device settings" action
             (no credential enrolled) launches these via `url_launcher`'s
             `intent://` support. Security settings first; this app's own
             "App info" page as the fallback when an OEM skin doesn't
             expose ACTION_SECURITY_SETTINGS. -->
        <intent>
            <action android:name="android.settings.SECURITY_SETTINGS"/>
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS"/>
        </intent>
    </queries>
</manifest>
