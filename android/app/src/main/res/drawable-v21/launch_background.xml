<?xml version="1.0" encoding="utf-8"?>
<!-- Issue #164: branded launch screen — the brand mark centred on its own
     background purple, replacing the stock `?android:colorBackground`. This
     is the variant applied on every supported device (minSdk 26); the
     `drawable/` twin is kept identical so the two cannot drift. The mark
     raster is generated by tool/branding/generate_brand_assets.py from
     assets/branding/app_icon_1024.png. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
