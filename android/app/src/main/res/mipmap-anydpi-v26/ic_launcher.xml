<?xml version="1.0" encoding="utf-8"?>
<!-- Issue #164: the Android 8+ (API 26+) adaptive launcher icon. Foreground
     and monochrome are the brand mark (assets/branding/app_icon_1024.png),
     generated per density by tool/branding/generate_brand_assets.py; the
     background is the mark's own brand purple. The monochrome layer is what
     Android 13+'s themed icons tint. minSdk is 26, so this file is the icon
     every supported device actually uses; the `mipmap-*/ic_launcher.png`
     fallbacks are regenerated from the same mark for consistency. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
