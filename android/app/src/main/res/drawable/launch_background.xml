<?xml version="1.0" encoding="utf-8"?>
<!-- Issue #164: branded launch screen — the brand mark centred on its own
     background purple, replacing the stock `@android:color/white`. The mark
     raster is generated by tool/branding/generate_brand_assets.py from
     assets/branding/app_icon_1024.png. A single drawable serves light and
     dark (see values/colors.xml); minSdk 26 means the `drawable-v21` twin is
     the one actually applied, and the two are kept identical so neither can
     drift. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
