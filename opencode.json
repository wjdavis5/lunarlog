{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "instructions": ["AGENTS.md", "CLAUDE.md"],
  "subagents": {
    "general": {
      "disable": true
    }
  },
  "agent": {
    "coordinator": {
      "mode": "primary",
      "description": "Engineering coordinator: picks GitHub issues by priority, dispatches coders into worktrees, reviews and merges PRs. Owns everything labeled owner:opencode-muse.",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "prompt": "{file:./.opencode/prompts/coordinator.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "deny"
      }
    },
    "coder": {
      "mode": "subagent",
      "description": "Implements exactly one GitHub issue inside an assigned git worktree under .worktrees/opencode-muse/ and opens a PR. Never touches main or any other worktree.",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "prompt": "{file:./.opencode/prompts/coder.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "deny"
      }
    }
  }
}
