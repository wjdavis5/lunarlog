# Supabase Configuration for lunarlog
#
# `.env` is SERVER-SIDE ONLY: it feeds the Supabase CLI and direct database
# access (migrations, psql). The Flutter app never reads it. Client-side values
# reach the app through --dart-define (see dart_defines.example.json and
# AGENTS.md); the publishable key is duplicated here only so the CLI has it.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_REF=<project-ref>
DATABASE_PASSWORD=<db-password>
DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
# App Store Connect API key for scripts/asc.rb release checks (names only,
# never values; the AuthKey_<KEY_ID>.p8 private key itself is gitignored and
# lives outside the repo — see AGENTS.md).
ASC_KEY_ID=<app-store-connect-key-id>
ASC_ISSUER_ID=<app-store-connect-issuer-id>
# Operator test-account seeder (issue #710; fabricated accounts only — see
# docs/ops/seed-test-account.md). The target and partner emails must both be
# members of the allowlist or the tool refuses to run. Optional per-account
# password overrides use LUNARLOG_SEED_PASSWORD_<UPPERCASE_EMAIL_SLUG>
# (non-alphanumerics become _, e.g. LUNARLOG_SEED_PASSWORD_SEED_E2E_LOCAL_EXAMPLE_COM).
LUNARLOG_SEED_ACCOUNT_EMAIL=
LUNARLOG_SEED_ALLOWLIST=
LUNARLOG_SEED_PARTNER_EMAIL=
LUNARLOG_SEED_PASSWORD=
