<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Issue #5, U7: remote caregiver alerts via FCM/APNs. This file now
	     backs the Release configuration only (App Store / distribution
	     signing requires "production"); Debug and Profile use
	     DebugProfile.entitlements' "development" value instead (review
	     #11) - a development-signed build cannot be signed against a
	     "production" aps-environment at all. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Issue #156: HealthKit platform plumbing only -- no clinical-records
	     access requested (com.apple.developer.healthkit.access left empty).
	     Issue #993: background delivery
	     (com.apple.developer.healthkit.background-delivery) is now requested
	     so the HKObserverQuery registration in AppDelegate.swift's
	     HealthKitChannelHandler can wake the app for the prompt-free import
	     pass — the same anchored, never-overwrite pipeline the Settings tap
	     runs, never a write. The App Store provisioning profile must be
	     regenerated with this capability (compounding with the Sign in with
	     Apple, Push, and App Group capabilities already on the App ID) — see
	     docs/ops/supabase-go-live.md's "Apple / Google store plumbing". -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.background-delivery</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<!-- Issue #129, #450: HTTPS universal-link fallback for invite/claim links.
	     Hosted domain is lunarlog.app, served by the Cloudflare Worker in
	     site/ which hosts /.well-known/apple-app-site-association. -->
	<!-- Issue #141: the shared suite the home-screen widget extension
	     reads (the discreet render payload written by the app's
	     WidgetStatePublisher through the `home_widget` plugin). The SAME
	     identifier is declared in LunarLogWidget.entitlements — an app
	     group works only when every member declares it, and device
	     signing requires the App Group capability on both App IDs plus
	     regenerated profiles carrying it (see the device checklist in
	     docs/ops/supabase-go-live.md). Unsigned CI builds are unaffected.
	     Fields crossing this boundary: exactly the six keys documented in
	     lib/domain/widget/widget_cycle_state.dart. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.wjdavis5.lunarlog.widgets</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:lunarlog.app</string>
	</array>
</dict>
</plist>
