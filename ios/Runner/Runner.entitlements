<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Issue #5, U7: remote caregiver alerts via FCM/APNs. This file now
	     backs the Release configuration only (App Store / distribution
	     signing requires "production"); Debug and Profile use
	     DebugProfile.entitlements' "development" value instead (review
	     #11) - a development-signed build cannot be signed against a
	     "production" aps-environment at all. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Issue #156: HealthKit platform plumbing only -- no clinical-records
	     access requested (com.apple.developer.healthkit.access left empty).
	     Background delivery (com.apple.developer.healthkit.background-delivery)
	     is deliberately NOT added here; it is scoped to #217 (HS-6)/#186
	     (HS-11) per A3-16, not needed for v1 write-only parity. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<!-- Issue #129: HTTPS universal-link fallback for invite/claim links.
	     The human provisioning the hosted domain (issue #384) replaces
	     __LUNARLOG_LINK_DOMAIN__ with that domain (e.g.
	     `applinks:links.example.com`) once DNS/hosting exist and the
	     AASA file in docs/links/ is served. Until then this placeholder
	     matches nothing and the custom `lunarlog://` scheme below is the
	     only working link form. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:__LUNARLOG_LINK_DOMAIN__</string>
	</array>
</dict>
</plist>
