<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>lunarlog</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>lunarlog</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- U4 (KTD8): auth callback scheme for confirmation and reset emails,
	     lunarlog://auth-callback. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.wjdavis5.lunarlog.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lunarlog</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.225603562138-n2vic47pchh7ipqsk3fd7udhd0akm3lm</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Export compliance (issue #48, docs/ops/ios-export-compliance.md): the
	     app compiles no third-party at-rest cipher into the binary (the
	     sqlcipher build hook was removed) -- the only cryptography present
	     is TLS to Supabase and OS-provided/authentication-only primitives,
	     so this is false. Do not add a compliance-code key here unless the
	     operator has actually obtained one; see the ops doc's R7 note. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- U7: why the app requests Face ID (device-credential gate). -->
	<key>NSFaceIDUsageDescription</key>
	<string>lunarlog uses Face ID to unlock your data.</string>
	<!-- Issue #156/#173/#217: HealthKit platform plumbing. Issue #217
	     (#781's owner decision) reverses the write-only posture this
	     comment used to describe: the app now asks for a non-empty read
	     set so the user-initiated "Import from Apple Health" action can
	     read menstrual-flow samples. The read set carries ONLY
	     menstrualFlow; Apple's four computed cycle-deviation types are
	     never requested, read, or written (App Review 5.1.3).

	     BOTH strings are required, and NSHealthShareUsageDescription
	     must NOT be removed (issue #766). #515 removed it as a
	     privacy-accuracy correction on the reasoning that an unused read
	     capability should not be declared; App Store Connect rejected
	     build 1135 for exactly that omission with ITMS-90683. That check
	     fires on *entitlements that permit access*, not only on call
	     sites, and Runner.entitlements declares
	     `com.apple.developer.healthkit`, which permits read. Removing the
	     key again re-breaks every upload. The string below now honestly
	     describes the read the code performs, and PRIVACY.md carries the
	     matching disclosure. -->
	<key>NSHealthShareUsageDescription</key>
	<string>lunarlog reads menstrual flow from Apple Health only when you choose to import it into the profile you have bound to this device, so you can bring in history you recorded elsewhere. Nothing is read automatically, and only menstrual-flow samples in the date range you import are read.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>lunarlog writes the bound profile's period, symptom, and mood data to Apple Health, only for the one profile you choose in Settings.</string>
	<!-- Issue #207: required by image_picker_ios the moment a gallery source
	     is offered; without it the photo pick crashes the app on iOS 14+.
	     Only the feedback sheet's screenshot attachment opens the picker. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>lunarlog uses your photo library only when you choose to attach a screenshot to a support ticket. Nothing is uploaded unless you pick an image and submit the ticket.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Issue #5, U7: lets a caregiver alert wake the app to handle a
	     silent/data push; the visible notification itself is delivered by
	     the system regardless of this key. Issue #174: this declaration is
	     now backed by the registered background handler
	     (pushBackgroundMessageHandler in
	     lib/data/notifications/push_presentation.dart, registered before
	     runApp() in lib/main.dart behind AppConfig.hasPush) — a data-only
	     push arriving while the app is backgrounded is presented by that
	     handler instead of the key being an unbacked App Review query. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
