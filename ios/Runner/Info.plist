<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>lunarlog</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>lunarlog</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- U4 (KTD8): auth callback scheme for confirmation and reset emails,
	     lunarlog://auth-callback. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.wjdavis5.lunarlog.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lunarlog</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.225603562138-n2vic47pchh7ipqsk3fd7udhd0akm3lm</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Export compliance (issue #48, docs/ops/ios-export-compliance.md): the
	     app compiles no third-party at-rest cipher into the binary (the
	     sqlcipher build hook was removed) -- the only cryptography present
	     is TLS to Supabase and OS-provided/authentication-only primitives,
	     so this is false. Do not add a compliance-code key here unless the
	     operator has actually obtained one; see the ops doc's R7 note. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- U7: why the app requests Face ID (device-credential gate). -->
	<key>NSFaceIDUsageDescription</key>
	<string>lunarlog uses Face ID to unlock your data.</string>
	<!-- Issue #156/#173: HealthKit platform plumbing, write-only by design
	     (issue #515) — AppDelegate.swift's `requestAuthorization` call
	     passes an empty `read` set (`toShare: toShare, read: []`), so this
	     app never reads HealthKit data.

	     BOTH strings are nevertheless required, and NSHealthShareUsageDescription
	     must NOT be removed again (issue #766). #515 removed it as a
	     privacy-accuracy correction on the reasoning that an unused read
	     capability should not be declared; App Store Connect rejected build
	     1135 for exactly that omission with ITMS-90683. That check fires on
	     *entitlements that permit access*, not only on call sites, and
	     Runner.entitlements declares `com.apple.developer.healthkit`, which
	     permits read. An empty `read:` array does not exempt the bundle.
	     Removing the key again re-breaks every upload.

	     #515's substantive point is preserved in the string's wording: it
	     states that the app does not read, rather than inventing a read
	     purpose the code does not have. If a real read call site is ever
	     added, rewrite this string to describe what is read and why, and
	     update PRIVACY.md to match. -->
	<key>NSHealthShareUsageDescription</key>
	<string>lunarlog never reads anything from Apple Health. iOS requires this permission text because the app is able to write to Apple Health; only writing is ever requested.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>lunarlog writes the bound profile's period and symptom data to Apple Health, only for the one profile you choose in Settings.</string>
	<!-- Issue #207: required by image_picker_ios the moment a gallery source
	     is offered; without it the photo pick crashes the app on iOS 14+.
	     Only the feedback sheet's screenshot attachment opens the picker. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>lunarlog uses your photo library only when you choose to attach a screenshot to a support ticket. Nothing is uploaded unless you pick an image and submit the ticket.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Issue #5, U7: lets a caregiver alert wake the app to handle a
	     silent/data push; the visible notification itself is delivered by
	     the system regardless of this key. Issue #174: this declaration is
	     now backed by the registered background handler
	     (pushBackgroundMessageHandler in
	     lib/data/notifications/push_presentation.dart, registered before
	     runApp() in lib/main.dart behind AppConfig.hasPush) — a data-only
	     push arriving while the app is backgrounded is presented by that
	     handler instead of the key being an unbacked App Review query. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
