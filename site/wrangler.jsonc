{
  "name": "lunarlog-links",
  "compatibility_date": "2026-09-20",
  "main": "worker/index.ts",

  // The only public origin. workers_dev is off deliberately (issue #450,
  // matching civics-flashcards): apex lunarlog.app is the only desired endpoint.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "lunarlog.app",
      "custom_domain": true
    }
  ],

  "assets": {
    // Issue #1099: the Astro build output. `site/public/*` (AASA, invite.html,
    // robots.txt, _headers, the brand images) is copied into it by the build,
    // so the Worker's static-asset layer serves the marketing pages plus the
    // universal-link files from one directory.
    "directory": "./dist",
    "binding": "ASSETS",
    // Issue #1090: without this the static-asset layer answers first, so
    // public/.well-known/apple-app-site-association went out as
    // application/octet-stream and /invite* as an unheadered invite.html --
    // both of the worker's branches below were dead code in production.
    "run_worker_first": ["/.well-known/*", "/invite*"],
    // Issue #1099: serve the styled Astro 404 page for any path with no
    // matching asset. This is also how `/fhir/*` stays a plain 404 and never
    // a redirect (issue #961 froze those URIs).
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      // Off deliberately (issue #450, docs/links/README.md). The automatic
      // invocation log retains request URLs and headers; invitation links carry
      // redeemable tokens in query strings that must not be retained.
      "invocation_logs": false
    }
  }
}
