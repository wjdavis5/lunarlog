---
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/fraunces/latin-600.css";
import "../styles/global.css";

// Preload the three latin faces the first viewport actually paints with.
// Without this, text renders in the fallback family and repaints when the
// swap lands — a measurable layout shift on the longer content pages that
// cost the Lighthouse performance budget (issue #1102: /support/ sat at
// 0.92 against the 0.95 floor). Preloading lets the font arrive alongside
// the render-blocking CSS, so the first paint already uses the real face.
// The `?url` imports resolve to the same hashed asset the @fontsource CSS
// references, so nothing is fetched twice.
import frauncesLatin600Url from "@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url";
import interLatin400Url from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import interLatin600Url from "@fontsource/inter/files/inter-latin-600-normal.woff2?url";

interface Props {
  /** Page title, shown in `<title>` and the OpenGraph tags. */
  title: string;
  /** One-sentence description used for the meta and OpenGraph description. */
  description: string;
  /** Set on the 404 page so it stays out of search indexes. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://lunarlog.app");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og-image.png", site).href;
// The home page's title says what lunarlog is. It used to be the bare
// name, which is all a search result, a browser tab or a shared link
// showed of it. Every other page is "<page> — lunarlog".
const homeTitle = "lunarlog — a cycle tracker a family shares";
const fullTitle = title === "lunarlog" ? homeTitle : `${title} — lunarlog`;

// The header carries the four pages a first-time visitor asks for, in the
// order the story is told: what it does, who it is shared with, whether it
// can be trusted, and how to use it. Four is also what fits on one row of a
// phone screen, so the header is the same at every width and needs no menu
// button (the site ships no JavaScript). Everything else is in the footer.
const headerLinks = [
  { href: "/tracking", label: "Tracking" },
  { href: "/family-sharing", label: "Family sharing" },
  { href: "/privacy-security", label: "Privacy" },
  { href: "/guides/", label: "Guides" },
];

// The footer is the whole map, under each page's own title, grouped by
// what a visitor came for.
const footerGroups = [
  {
    heading: "What it does",
    links: [
      { href: "/tracking", label: "Tracking and viewing" },
      { href: "/family-sharing", label: "Family sharing and roles" },
      { href: "/life-stage-modes", label: "Life-stage modes" },
      { href: "/import", label: "Import" },
      { href: "/export", label: "Export" },
    ],
  },
  {
    heading: "Help",
    links: [
      { href: "/guides/", label: "How-to guides" },
      { href: "/learn/", label: "Cycle literacy" },
      { href: "/support", label: "Support" },
      { href: "/delete-account", label: "Delete your account" },
    ],
  },
  {
    heading: "Privacy",
    links: [
      { href: "/privacy-security", label: "Privacy and security" },
      { href: "/privacy", label: "Privacy policy" },
    ],
  },
];

// `aria-current` for a link: "page" on the page itself, "true" on the
// section a deeper page sits in (a guide marks "Guides"), nothing otherwise.
const trimSlash = (value: string) => value.replace(/\/+$/, "") || "/";
const here = trimSlash(Astro.url.pathname);
function currentFor(href: string): "page" | "true" | undefined {
  const target = trimSlash(href);
  if (here === target) return "page";
  return target !== "/" && here.startsWith(`${target}/`) ? "true" : undefined;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={frauncesLatin600Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin400Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin600Url} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="lunarlog" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/">
          <img
            class="brand__mark"
            src="/brand-mark.png"
            width="32"
            height="32"
            alt=""
          />
          <span>lunarlog</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              headerLinks.map((link) => (
                <li>
                  <a href={link.href} aria-current={currentFor(link.href)}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="content">
      <div class="page">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <nav class="site-map" aria-label="All pages">
          {
            footerGroups.map((group) => (
              <div class="site-map__group">
                <h2>{group.heading}</h2>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a href={link.href} aria-current={currentFor(link.href)}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
        <p class="site-footer__legal">
          &copy; {new Date().getFullYear()} lunarlog
        </p>
      </div>
    </footer>
  </body>
</html>
