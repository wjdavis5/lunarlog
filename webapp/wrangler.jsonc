{
  "name": "lunarlog-app-staging",
  "compatibility_date": "2026-09-20",
  "main": "worker/index.ts",

  // Issue #1250: the Worker also answers the same-origin /auth/* API
  // routes (worker/auth.ts). Its one runtime input is the Supabase
  // publishable key, a client-safe value set as a Wrangler secret by
  // webapp-deploy.yml from the SUPABASE_ANON_KEY repository secret —
  // never committed here, so a fork's build still works (the auth routes
  // answer 503 auth_not_configured until the secret exists).

  // Issue #1258 (owner go 2026-10-03): app.lunarlog.app is this Worker's
  // production origin, bound as a CUSTOM DOMAIN since 2026-10-03 -
  // Cloudflare manages the hostname's DNS. (The attach had been refused by
  // leftover zone DNS records from the retired Pages project, error 100117;
  // they are gone, and #1624 removed the workflow's clearing step.) A route
  // was tried instead (#1402, #1403) and reverted by #1404. The workers.dev
  // hostname stays on as the staging alias (#1249).
  "workers_dev": true,
  "routes": [{ "pattern": "app.lunarlog.app", "custom_domain": true }],

  "assets": {
    // `npm run build` output (Vite). Served through the Worker (see
    // run_worker_first) so the declared security headers land on every
    // response, including the SPA fallback.
    "directory": "./dist",
    "binding": "ASSETS",
    // Every path is worker-first: worker/index.ts sets the security headers
    // unconditionally, so the asset layer's guesses can never win. Array
    // form — the shape wrangler 4.20.0 accepts (see site/wrangler.jsonc for
    // the version history).
    "run_worker_first": ["/*"],
    // Single-page application: deep links (the auth screens and the
    // /auth/callback landing the Worker hands back) fall back to index.html,
    // never a 404.
    "not_found_handling": "single-page-application",
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      // Off deliberately, matching site/wrangler.jsonc (issue #450): the
      // automatic invocation log retains request URLs and headers.
      "invocation_logs": false,
    },
  },
}
